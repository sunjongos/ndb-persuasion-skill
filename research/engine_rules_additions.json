   "sources": [
    "HACKEN2025B",
    "LIN2025",
    "GOLDSTEIN2024"
   ],
   "source_grades": [
    "B"
   ]
  },
  {
   "id": "aud.high_involvement",
   "kind": "strategy_selection",
   "when": {
    "audience.involvement": "high"
   },
   "then": {
    "prefer": [
     "technique.evidence",
     "technique.two_sided_refutational"
    ],
    "avoid": [
     "주변 단서 단독"
    ],
    "why": "중심경로: 논증 질이 결정, 변화가 오래감"
   },
   "sources": [
    "PETTY1981",
    "PETTY1986",
    "OKEEFE1999"
   ],
   "source_grades": [
    "A",
    "B"
   ]
  },
  {
   "id": "aud.low_involvement",
   "kind": "strategy_selection",
   "when": {
    "audience.involvement": "low"
   },
   "then": {
    "prefer": [
     "신뢰 출처 명시",
     "간결한 핵심 사실",
     "기본값(이익 일치 시)"
    ],
    "require": "FactGate 통과",
    "why": "주변경로 단서 영향 큼 — 단서도 진실해야"
   },
   "sources": [
    "PETTY1986",
    "CHAIKEN1980",
    "JACHIM2019"
   ],
   "source_grades": [
    "A",
    "B"
   ]
  },
  {
   "id": "aud.opposed_identity",
   "kind": "strategy_selection",
   "when": {
    "audience.prior_attitude": "opposed",
    "audience.identity_threat": "high"
   },
   "then": {
    "prefer": [
     "technique.moral_reframing",
     "technique.deep_canvassing",
     "technique.byaf"
    ],
    "avoid": [
     "조롱",
     "상대 집단 공격",
     "명령형"
    ],
    "why": "정체성 위협→반발; 판단 없는 경청과 상대 가치 언어"
   },
   "sources": [
    "FEINBERG2015",
    "KALLA2020",
    "RAINS2013",
    "CARPENTER2013"
   ],
   "source_grades": [
    "A",
    "B"
   ]
  },
  {
   "id": "aud.opposed_low_identity",
   "kind": "strategy_selection",
   "when": {
    "audience.prior_attitude": "opposed",
    "audience.identity_threat": "low"
   },
   "then": {
    "prefer": [
     "technique.evidence",
     "정정 시 상세 반박"
    ],
    "why": "정보는 반대자도 같은 방향으로 움직임(평행 설득), 역효과 드묾"
   },

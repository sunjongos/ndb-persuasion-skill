{
 "meta": {
  "created_kst": "2026-10-25",
  "note": "기존 엔진 파일 미수정. 이 파일은 추가 규칙 제안. sources는 sources.csv id. 등급 D 근거 기법 추천 금지.",
  "kinds": [
   "cue_detection",
   "evidence_ban",
   "fact_gate",
   "manipulation_detection",
   "strategy_selection"
  ]
 },
 "rules": [
  {
   "id": "cue.repetition",
   "kind": "cue_detection",
   "when": {
    "any_regex": [
     "반복",
     "계속 말",
     "다들 알다시피",
     "몇 번이고"
    ],
    "or_signal": "동일 주장 3회 이상 반복"
   },
   "then": {
    "flag": "illusory_truth",
    "map": [
     "Munger:#18 가용성",
     "Munger:#10 단순 연관"
    ],
    "action": "반복 횟수와 근거 수를 분리 표시"
   },
   "sources": [
    "DECHENE2010",
    "FAZIO2015",
    "HASSAN2021"
   ],
   "source_grades": [
    "A"
   ]
  },
  {
   "id": "cue.we_identity",
   "kind": "cue_detection",
   "when": {
    "any_regex": [
     "우리 ",
     "우리가",
     "같은 편",
     "한 식구",
     "동문",
     "고향"
    ]
   },
   "then": {
    "flag": "unity",
    "map": [
     "Cialdini:연대감"
    ],
    "action": "공유 정체성이 실제인지 확인"
   },
   "sources": [
    "CIAL2021",
    "MOGAN2017"
   ],
   "source_grades": [
    "A",
    "B"
   ]
  },
  {
   "id": "cue.outgroup_hostility",
   "kind": "cue_detection",
   "when": {
    "any_regex": [
     "저쪽",
     "저들",
     "배신자",
     "적폐",
     "빨갱이",
     "토착왜구"
    ]
   },
   "then": {
    "flag": "affective_polarization",
    "action": "정체성 공격 표시; 사실 주장과 분리"
   },
   "sources": [
    "IYENGAR2012",
    "IYENGAR2019"
   ],
   "source_grades": [
    "B"
   ]
  },
  {
   "id": "cue.deadline_scarcity",
   "kind": "cue_detection",
   "when": {
    "any_regex": [
     "오늘만",
     "마감 임박",
     "한정",
     "남은 수량",
     "지금 아니면"
    ]
   },
   "then": {
    "flag": "scarcity_or_loss_frame",
    "map": [
     "Cialdini:희귀성",
     "Munger:#14 박탈 초반응"
    ],
    "action": "희소성 사실 여부 검증(재고·마감 근거)"
   },
   "sources": [
    "KT1979",
    "MATHUR2019"
   ],
   "source_grades": [
    "A",
    "B"
   ]
  },
  {
   "id": "cue.everyone_does",
   "kind": "cue_detection",
   "when": {
    "any_regex": [
     "다들",
     "대부분",
     "%가 선택",
     "1위",
     "많은 분들이"
    ]
   },
   "then": {
    "flag": "social_proof",
    "map": [
     "Cialdini:사회적 증거",
     "Munger:#15"
    ],
    "action": "다수 수치 출처 확인"
   },
   "sources": [
    "CIAL2004",
    "ALLCOTT2011",
    "BARNFIELD2020"
   ],
   "source_grades": [
    "A",
    "C"
   ]
  },
  {
   "id": "cue.authority",
   "kind": "cue_detection",
   "when": {
    "any_regex": [
     "교수",
     "전문의",
     "박사",
     "권위자",
     "하버드",
     "논문에 따르면"
    ]
   },
   "then": {
    "flag": "authority",
    "map": [
     "Cialdini:권위",
     "Munger:#22"
    ],
    "action": "전문 분야 일치·이해상충·원문 확인"
   },
   "sources": [
    "PORNPIT2004",
    "BURGER2009"
   ],
   "source_grades": [
    "B"
   ]
  },
  {
   "id": "cue.placebic_reason",
   "kind": "cue_detection",
   "when": {
    "any_regex": [
     "왜냐하면",
     "때문에"
    ],
    "and": "이유 내용이 요청을 반복할 뿐"
   },
   "then": {
    "flag": "placebic_reason",
    "map": [
     "Munger:#24 이유 존중"
    ],
    "action": "이유의 실질 내용 평가"
   },
   "sources": [
    "LANGER1978"
   ],
   "source_grades": [
    "C"
   ]
  },
  {
   "id": "cue.reciprocity_gift",
   "kind": "cue_detection",
   "when": {
    "any_regex": [
     "무료로 드",
     "선물",
     "특별히 해드",
     "먼저 양보"
    ]
   },
   "then": {
    "flag": "reciprocity",
    "map": [
     "Cialdini:상호성",
     "Munger:#9"
    ],
    "action": "선물과 요청을 분리 평가"
   },
   "sources": [
    "CIAL2004",
    "FEELEY2012"
   ],
   "source_grades": [
    "A",
    "B"
   ]
  },
  {
   "id": "cue.fear_without_efficacy",
   "kind": "cue_detection",
   "when": {
    "signal": "위협 강조 있음 AND 구체적 실행 방법 없음"
   },
   "then": {
    "flag": "fear_no_efficacy",
    "action": "효능감 정보 추가 요구"
   },
   "sources": [
    "WITTE2000",
    "TANNEN2015"
   ],
   "source_grades": [
    "A"
   ]
  },
  {
   "id": "cue.narrative",
   "kind": "cue_detection",
   "when": {
    "signal": "개인 사례 이야기 중심, 통계 없음"
   },
   "then": {

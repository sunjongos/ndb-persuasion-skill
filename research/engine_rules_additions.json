    "OKEEFE1999",
    "STACEY2024"
   ],
   "source_grades": [
    "A"
   ]
  },
  {
   "id": "aud.goal_behavior",
   "kind": "strategy_selection",
   "when": {
    "goal": "behavior"
   },
   "then": {
    "prefer": [
     "technique.direct_ask",
     "technique.implementation_intention",
     "technique.reminder_text"

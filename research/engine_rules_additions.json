    "COPPOCK2023",
    "WOOD2019",
    "CHAN2017"
   ],
   "source_grades": [
    "A"
   ]
  },
  {
   "id": "aud.undecided",
   "kind": "strategy_selection",
   "when": {
    "audience.prior_attitude": "neutral"
   },
   "then": {
    "prefer": [
     "technique.two_sided_refutational",
     "technique.sdm"
    ],
    "why": "양면 반박이 신뢰·설득 모두 높음"
   },

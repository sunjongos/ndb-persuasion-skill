   ]
  },
  {
   "id": "cue.commitment_ladder",
   "kind": "cue_detection",
   "when": {
    "signal": "작은 동의 요청 후 큰 요청"
   },
   "then": {
    "flag": "fitd_commitment",
    "map": [
     "Cialdini:일관성",
     "Munger:#5"
    ],
    "action": "각 단계 독립 판단"
   },
   "sources": [
    "BURGER1999"
   ],
   "source_grades": [
    "B"
   ]
  },
  {
   "id": "cue.ai_generated_mass",
   "kind": "cue_detection",
   "when": {
    "signal": "짧은 시간에 대량·고밀도 주장, 출처 다수지만 검증 불가"
   },
   "then": {
    "flag": "ai_information_flood",
    "action": "무작위 3개 주장 표본 사실검증"
